# Linker script that exports the minimal symbols required for libflutter.so

{
  global:
    JNI_OnLoad;
    _binary_icudtl_dat_start;
    _binary_icudtl_dat_size;
    InternalFlutterGpu*;
    kInternalFlutterGpu*;
    revon_init;
    revon_active_path;
    revon_active_patch_number;
    revon_free_string;
    revon_free_update_result;
    revon_check_for_downloadable_update;
    revon_check_for_update;
    revon_update;
    revon_update_with_result;
    revon_next_boot_patch_number;
    revon_current_boot_patch_number;
    revon_validate_next_boot_patch;
  local:
    *;
};
